---
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  subtitle?: string;
  description: string;
  status: string;
  statusNote?: string;
  tech: string[];
  tags: string[];
  isFork?: boolean;
  forkedFrom?: string;
  forkedFromUrl?: string;
  hackathonName?: string;
  hackathonUrl?: string;
  replacementLabel?: string;
  replacementUrl?: string;
  buildsOnLabels?: string[];
  buildsOnUrls?: string[];
  links?: {
    github?: string;
    homepage?: string;
    demo?: string;
    schematic?: string;
    bom?: string;
    designFiles?: string;
  };
}

const {
  title,
  subtitle = "",
  description,
  status,
  statusNote = "",
  tech,
  tags,
  isFork = false,
  forkedFrom = "",
  forkedFromUrl = "",
  hackathonName = "",
  hackathonUrl = "",
  replacementLabel = "",
  replacementUrl = "",
  buildsOnLabels = [],
  buildsOnUrls = [],
  links = {},
} = Astro.props;
const buildsOnPairs = buildsOnLabels.map((label, index) => ({
  label,
  url: buildsOnUrls[index] || "",
}));

const statusClassMap = {
  idea: "bg-primary/10 text-primary border border-primary/30",
  researching: "bg-primary/10 text-primary border border-primary/30",
  "building-now": "bg-primary/10 text-primary border border-primary/30",
  "building-paused": "bg-primary/10 text-primary border border-primary/30",
  dormant: "bg-primary/10 text-primary border border-primary/30",
  shipped: "bg-primary/10 text-primary border border-primary/30",
  blocked: "bg-primary/10 text-primary border border-primary/30",
  archived: "bg-primary/10 text-primary border border-primary/30",
};

const normalizeStatusKey = (value: string) =>
  value
    .toLowerCase()
    .trim()
    .replace(/\s*:\s*/g, "-")
    .replace(/\s+/g, "-")
    .replace("in-progress-paused", "dormant")
    .replace("backlog", "idea");

const statusKey = normalizeStatusKey(status || "idea");

const formatStatus = (value: string) => {
  const key = normalizeStatusKey(value || "idea");
  const labels = {
    "building-now": "🔧 Building: now",
    "building-paused": "⏸️ Building: paused",
    dormant: "😴 Dormant",
    idea: "💡 Idea",
    researching: "🔎 Researching",
    blocked: "⛔ Blocked",
    shipped: "✅ Shipped",
    archived: "🗃️ Archived",
  };

  if (key in labels) {
    return labels[key as keyof typeof labels];
  }

  return key
    .split("-")
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(" ");
};
---

<header
  class="decor-panel decor-soft mb-8 rounded-2xl border border-border bg-card p-6 text-card-foreground backdrop-blur-sm md:p-8"
  style="--card-art: url('/assets/cards/sinsincollage.jpg');"
>
  <div class="mb-4 flex flex-wrap items-center gap-3">
    <span
      class={`rounded-full px-3 py-1 text-xs font-medium ${statusClassMap[statusKey as keyof typeof statusClassMap] || "border border-primary/30 bg-primary/10 text-primary"}`}
    >
      {formatStatus(status)}
    </span>
    {
      tags.map((tag) => (
        <span class="rounded-full border border-border bg-muted/30 px-2.5 py-1 text-xs text-muted-foreground">
          {tag}
        </span>
      ))
    }
  </div>

  <h1 class="font-brand mb-3 text-4xl text-foreground md:text-5xl">{title}</h1>

  {
    subtitle && (
      <p class="mb-4 text-lg leading-relaxed font-semibold text-primary/90">
        {subtitle}
      </p>
    )
  }

  {
    isFork && forkedFrom && (
      <p class="mb-2 text-xs text-muted-foreground">
        Forked from{" "}
        {forkedFromUrl ? (
          <a
            href={forkedFromUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary hover:underline"
          >
            {forkedFrom}
          </a>
        ) : (
          <span>{forkedFrom}</span>
        )}
      </p>
    )
  }

  {
    (hackathonName || hackathonUrl) && (
      <p class="mb-2 text-xs text-muted-foreground">
        Hackathon:{" "}
        {hackathonUrl ? (
          <a
            href={hackathonUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary hover:underline"
          >
            {hackathonName || "More info"}
          </a>
        ) : (
          <span>{hackathonName || "Hackathon entry"}</span>
        )}
      </p>
    )
  }

  {
    statusKey === "archived" && (replacementLabel || replacementUrl) && (
      <p class="mb-2 text-xs text-muted-foreground">
        Replaced by:{" "}
        {replacementUrl ? (
          <a
            href={replacementUrl}
            target={replacementUrl.startsWith("http") ? "_blank" : undefined}
            rel={
              replacementUrl.startsWith("http")
                ? "noopener noreferrer"
                : undefined
            }
            class="text-primary hover:underline"
          >
            {replacementLabel || "newer project"}
          </a>
        ) : (
          <span>{replacementLabel || "newer project"}</span>
        )}
      </p>
    )
  }

  {
    buildsOnPairs.length > 0 && (
      <div class="mb-5 flex flex-wrap items-center gap-2">
        <span class="rounded-full border border-primary/35 bg-primary/10 px-3 py-1 text-xs font-semibold tracking-wider text-primary uppercase">
          Builds On
        </span>
        {buildsOnPairs.map((item) =>
          item.url ? (
            <a
              href={item.url}
              target={item.url.startsWith("http") ? "_blank" : undefined}
              rel={
                item.url.startsWith("http") ? "noopener noreferrer" : undefined
              }
              class="rounded-full border border-border bg-muted/30 px-3 py-1.5 text-xs font-medium text-primary transition-colors hover:border-primary/40 hover:text-primary"
            >
              {item.label}
            </a>
          ) : (
            <span class="rounded-full border border-border bg-muted/30 px-3 py-1.5 text-xs font-medium text-primary">
              {item.label}
            </span>
          ),
        )}
      </div>
    )
  }

  <p class="mb-5 max-w-3xl text-base leading-relaxed text-muted-foreground">
    {description}
  </p>

  {statusNote && <p class="mb-5 text-sm text-muted-foreground">{statusNote}</p>}

  {
    (links.github ||
      links.homepage ||
      links.demo ||
      links.schematic ||
      links.bom ||
      links.designFiles) && (
      <div class="mb-5 flex flex-wrap gap-2">
        {links.github && (
          <a
            href={links.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-full border border-border bg-muted/30 px-3 py-1.5 text-xs font-medium text-foreground transition-colors hover:border-primary/40 hover:text-primary"
          >
            <Icon name="mdi:github" /> GitHub
          </a>
        )}
        {links.homepage && (
          <a
            href={links.homepage}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-full border border-border bg-muted/30 px-3 py-1.5 text-xs font-medium text-foreground transition-colors hover:border-primary/40 hover:text-primary"
          >
            <Icon name="mdi:web" /> Homepage
          </a>
        )}
        {links.demo && (
          <a
            href={links.demo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-full border border-border bg-muted/30 px-3 py-1.5 text-xs font-medium text-foreground transition-colors hover:border-primary/40 hover:text-primary"
          >
            <Icon name="mdi:play-circle-outline" /> Demo
          </a>
        )}
        {links.schematic && (
          <a
            href={links.schematic}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-full border border-primary/35 bg-primary/10 px-3 py-1.5 text-xs font-medium text-primary transition-colors hover:border-primary/60 hover:bg-primary/15"
          >
            <Icon name="mdi:sitemap-outline" /> Schematic
          </a>
        )}
        {links.bom && (
          <a
            href={links.bom}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-full border border-primary/35 bg-primary/10 px-3 py-1.5 text-xs font-medium text-primary transition-colors hover:border-primary/60 hover:bg-primary/15"
          >
            <Icon name="mdi:format-list-bulleted" /> BOM
          </a>
        )}
        {links.designFiles && (
          <a
            href={links.designFiles}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-full border border-primary/35 bg-primary/10 px-3 py-1.5 text-xs font-medium text-primary transition-colors hover:border-primary/60 hover:bg-primary/15"
          >
            <Icon name="mdi:file-cad-box" /> Design files
          </a>
        )}
      </div>
    )
  }

  <div class="flex flex-wrap gap-2">
    {
      tech.map((item) => (
        <span class="rounded-full border border-border bg-muted/30 px-2.5 py-1 text-xs text-muted-foreground">
          {item}
        </span>
      ))
    }
  </div>

  <div id="project-summary"></div>
</header>
