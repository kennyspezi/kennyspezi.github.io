---
import site from "@/config/site";
import { Icon } from "astro-icon/components";
import { getPublishedPosts } from "@/utils/post";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const hasPublishedPosts = (await getPublishedPosts()).length > 0;
const navigation = site.navigation.filter(
  (item) => item.href !== "/posts" || hasPublishedPosts,
);
---

<aside
  class:list={[
    "flex w-full flex-col border-b border-border bg-card p-3 shadow-[inset_0_1px_0_rgba(244,165,103,0.25),inset_0_0_0_1px_rgba(202,55,43,0.12)] transition-[width,padding] duration-300 ease-out md:border-r md:border-b-0 md:p-5",
    compact ? "md:w-20" : "md:w-48",
  ]}
  data-pagefind-ignore="all"
>
  <div
    class:list={[
      "mb-3 flex max-md:hidden md:mb-4",
      compact ? "justify-center" : "justify-center",
    ]}
  >
    <a
      href="/"
      class:list={[
        "block transition-opacity hover:opacity-85",
        compact ? "w-10" : "w-28",
      ]}
      title={site.meta.title}
      aria-label={site.meta.title}
    >
      <img
        src={site.meta.logo}
        alt={site.meta.title}
        class="h-auto w-full object-contain"
        loading="eager"
      />
    </a>
  </div>

  <nav
    class:list={[
      "no-scrollbar flex flex-nowrap overflow-x-auto max-md:justify-start md:flex-1 md:flex-col md:overflow-x-visible",
      compact ? "items-center gap-4 md:gap-4" : "gap-2 md:gap-2.5",
    ]}
  >
    {
      navigation.map((item) => {
        const isActive =
          item.href === "/"
            ? Astro.url.pathname === "/"
            : Astro.url.pathname === item.href ||
              Astro.url.pathname.startsWith(`${item.href}/`);

        return (
          <a
            href={item.href}
            class:list={[
              "group flex rounded-2xl border border-transparent transition-all duration-250 hover:border-primary/20 hover:bg-primary/10",
              compact
                ? "h-12 w-12 items-center justify-center p-0"
                : "min-w-max items-center gap-2 px-3 py-2 md:min-w-24 md:gap-2.5 md:px-3.5 md:py-2.5",
            ]}
            title={item.name}
            aria-label={item.name}
            aria-current={isActive ? "page" : undefined}
          >
            <Icon
              name={item.icon || "mdi:link-variant"}
              class:list={["text-primary", compact ? "h-5.5 w-5.5" : "h-5 w-5"]}
            />
            {!compact && (
              <div class="flex max-w-40 flex-col overflow-hidden transition-[max-width,opacity,margin] duration-250 ease-out">
                <span class:list={["text-sm font-bold", "text-primary"]}>
                  {item.name}
                </span>
                <span class="text-[10px] tracking-widest text-muted-foreground/60 uppercase">
                  {item.subtitle}
                </span>
              </div>
            )}
          </a>
        );
      })
    }
  </nav>

  <div
    class:list={[
      "mt-3 flex items-center md:mt-10",
      compact ? "flex-col justify-center gap-4" : "justify-between",
    ]}
  >
    <div
      class:list={[
        "text-muted-foreground/60",
        compact ? "flex flex-col items-center gap-3" : "flex gap-3",
      ]}
    >
      {
        site.social.map((item) => (
          <a
            href={item.href}
            class:list={[
              "cursor-pointer transition-colors hover:text-primary",
              compact
                ? "flex h-9 w-9 items-center justify-center rounded-full hover:bg-primary/10"
                : "",
            ]}
            aria-label={item.name}
          >
            <Icon name={item.icon} class="h-5 w-5" />
          </a>
        ))
      }
    </div>
  </div>
</aside>
