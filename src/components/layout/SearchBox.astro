---
import { Icon } from "astro-icon/components";
---

<div class="mb-4">
  <button
    id="search-trigger"
    class="group flex w-full items-center justify-between rounded-xl border border-border/50 bg-muted/30 px-3 py-2.5 text-muted-foreground hover:border-primary/30 hover:text-primary"
    title="search trigger"
  >
    <div class="flex items-center gap-2">
      <Icon name="mdi:magnify" />
      <span class="text-xs font-medium">Search</span>
    </div>
    <kbd
      class="hidden items-center gap-1 rounded border border-border/50 px-2 py-0.5 font-display text-[11px] opacity-60 md:flex"
    >
      Ctrl + K
    </kbd>
  </button>
</div>
