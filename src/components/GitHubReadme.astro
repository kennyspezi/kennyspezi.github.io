---
import { marked } from "marked";
import { Icon } from "astro-icon/components";

interface Props {
  repo: string;
}

const { repo } = Astro.props;

const normalizeRepo = (input: string) => {
  if (input.startsWith("http")) {
    const url = new URL(input);
    return url.pathname.replace(/^\//, "").replace(/\.git$/, "");
  }
  return input.replace(/\.git$/, "");
};

const repoPath = normalizeRepo(repo);
const token = import.meta.env.GITHUB_TOKEN;
const defaultBranch = "main";

const toRawGitHubUrl = (
  repoFullName: string,
  branch: string,
  value: string,
) => {
  const cleaned = value
    .trim()
    .replace(/^\.\//, "")
    .replace(/^\//, "")
    .replace(/\.\.\//g, "");
  return `https://raw.githubusercontent.com/${repoFullName}/${branch}/${cleaned}`;
};

const toBlobGitHubUrl = (
  repoFullName: string,
  branch: string,
  value: string,
) => {
  const cleaned = value
    .trim()
    .replace(/^\.\//, "")
    .replace(/^\//, "")
    .replace(/\.\.\//g, "");
  return `https://github.com/${repoFullName}/blob/${branch}/${cleaned}`;
};

const toRenderableGitHubImageUrl = (value: string) => {
  const cleaned = String(value || "").trim();
  if (/^https?:\/\/github\.com\/.+\/blob\/.+$/i.test(cleaned)) {
    return cleaned.includes("?") ? `${cleaned}&raw=1` : `${cleaned}?raw=1`;
  }
  return cleaned;
};

const isRelativeMarkdownPath = (value: string) => {
  const cleaned = String(value || "").trim();
  if (
    cleaned.startsWith("http://") ||
    cleaned.startsWith("https://") ||
    cleaned.startsWith("mailto:") ||
    cleaned.startsWith("tel:") ||
    cleaned.startsWith("#") ||
    cleaned.startsWith("//")
  ) {
    return false;
  }
  return cleaned.length > 0;
};

const isImagePath = (value: string) =>
  /\.(png|jpe?g|gif|webp|svg|avif|bmp)(\?.*)?$/i.test(
    String(value || "").trim(),
  );

const rewriteReadmeMarkdown = (
  markdown: string,
  repoFullName: string,
  branch: string,
) => {
  let output = markdown;

  // Relative image links -> raw URLs for rendering in <img>.
  output = output.replace(
    /!\[([^\]]*)\]\(([^)\s]+)(?:\s+"[^"]*")?\)/g,
    (match, alt, link) => {
      const cleaned = String(link || "").trim();
      if (cleaned.startsWith("http://") || cleaned.startsWith("https://")) {
        if (/^https?:\/\/github\.com\/.+\/blob\/.+$/i.test(cleaned)) {
          return `![${alt}](${toRenderableGitHubImageUrl(cleaned)})`;
        }
        return match;
      }
      if (
        cleaned.startsWith("#") ||
        cleaned.startsWith("mailto:") ||
        cleaned.startsWith("tel:") ||
        cleaned.startsWith("//")
      ) {
        return match;
      }
      return `![${alt}](${toRawGitHubUrl(repoFullName, branch, cleaned)})`;
    },
  );

  // Relative non-image links -> blob URLs.
  output = output.replace(
    /(?<!!)\[([^\]]+)\]\(([^)\s]+)(?:\s+"[^"]*")?\)/g,
    (match, text, link) => {
      const cleaned = String(link || "").trim();
      if (
        cleaned.startsWith("http://") ||
        cleaned.startsWith("https://") ||
        cleaned.startsWith("#") ||
        cleaned.startsWith("mailto:") ||
        cleaned.startsWith("tel:") ||
        cleaned.startsWith("//")
      ) {
        return match;
      }
      return `[${text}](${toBlobGitHubUrl(repoFullName, branch, cleaned)})`;
    },
  );

  // Relative markdown reference links: [id]: path
  output = output.replace(
    /^\s{0,3}\[([^\]]+)\]:\s*(\S+)(\s+"[^"]*")?\s*$/gm,
    (match, ref, link, title = "") => {
      if (!isRelativeMarkdownPath(link)) {
        return match;
      }
      const rewritten = isImagePath(link)
        ? toRawGitHubUrl(repoFullName, branch, link)
        : toBlobGitHubUrl(repoFullName, branch, link);
      return `[${ref}]: ${rewritten}${title || ""}`;
    },
  );

  // Relative links in raw HTML tags frequently found in README files.
  output = output.replace(
    /(<img\b[^>]*\bsrc=["'])([^"']+)(["'][^>]*>)/gi,
    (match, prefix, url, suffix) => {
      if (!isRelativeMarkdownPath(url)) {
        return `${prefix}${toRenderableGitHubImageUrl(url)}${suffix}`;
      }
      return `${prefix}${toRawGitHubUrl(repoFullName, branch, url)}${suffix}`;
    },
  );
  output = output.replace(
    /(<a\b[^>]*\bhref=["'])([^"']+)(["'][^>]*>)/gi,
    (match, prefix, url, suffix) => {
      if (!isRelativeMarkdownPath(url)) {
        return match;
      }
      return `${prefix}${toBlobGitHubUrl(repoFullName, branch, url)}${suffix}`;
    },
  );

  return output;
};

let readmeHtml = "";
let fetchError = "";

try {
  const response = await fetch(
    `https://api.github.com/repos/${repoPath}/readme`,
    {
      headers: {
        Accept: "application/vnd.github+json",
        ...(token ? { Authorization: `Bearer ${token}` } : {}),
      },
    },
  );

  if (!response.ok) {
    throw new Error(`Failed to fetch README (${response.status})`);
  }

  const data = await response.json();
  const decoded = Buffer.from(data.content, "base64").toString("utf-8");
  const branchFromDownload =
    typeof data?.download_url === "string"
      ? data.download_url.match(
          /^https?:\/\/raw\.githubusercontent\.com\/[^/]+\/[^/]+\/([^/]+)\//i,
        )?.[1]
      : undefined;
  const branch = branchFromDownload || defaultBranch;
  const rewritten = rewriteReadmeMarkdown(decoded, repoPath, branch);
  readmeHtml = marked.parse(rewritten) as string;
} catch (error) {
  fetchError =
    error instanceof Error ? error.message : "Unable to load README right now.";
}
---

<section
  id="project-readme"
  class="decor-panel decor-soft mb-8 rounded-2xl border border-sky-300/25 bg-sky-50/25 p-6 text-card-foreground backdrop-blur-sm dark:border-sky-700/25 dark:bg-sky-950/10"
  style="--card-art: url('/assets/cards/wistygoldfish.jpg');"
>
  <h2 class="font-brand mb-4 flex items-center gap-2 text-2xl text-foreground">
    <span
      class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-sky-300/40 bg-sky-100/60 text-sky-700 dark:border-sky-700/40 dark:bg-sky-900/25 dark:text-sky-300"
    >
      <Icon name="mdi:glasses" class="h-5 w-5" />
    </span>
    GitHub README
  </h2>

  {
    fetchError ? (
      <p class="text-sm text-muted-foreground">{fetchError}</p>
    ) : (
      <div
        class="article-content prose max-w-none dark:prose-invert"
        set:html={readmeHtml}
      />
    )
  }
</section>
