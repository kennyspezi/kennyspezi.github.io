---
import { getCollection } from "astro:content";
import { getPosts } from "@/utils/post";
import about from "@/content/data/about.json";
import ignoredRepos from "@/content/data/ignoredrepoentry.json";
import { projectDateValue } from "@/utils/project-normalize";

const ignoredRepoSet = new Set(
  ignoredRepos.map((item) => String(item).toLowerCase()),
);
const cardArt = [
  "/assets/cards/flowers.jpg",
  "/assets/cards/orangerays.jpg",
  "/assets/cards/fishes.jpg",
  "/assets/cards/gratitude.jpg",
  "/assets/cards/tiles.jpg",
  "/assets/cards/sunrug.jpg",
  "/assets/cards/sinsincollage.jpg",
  "/assets/cards/wistygoldfish.jpg",
];
const normalizeStatus = (status: string) =>
  (status || "idea")
    .toLowerCase()
    .trim()
    .replace(/\s*:\s*/g, "-")
    .replace(/\s+/g, "-")
    .replace("in-progress-paused", "dormant")
    .replace("backlog", "idea");
const statusLabelMap: Record<string, string> = {
  idea: "Idea",
  researching: "Researching",
  "building-now": "Building",
  "building-paused": "Paused",
  dormant: "Dormant",
  blocked: "Blocked",
  shipped: "Shipped",
  archived: "Archived",
};
const statusClassMap: Record<string, string> = {
  idea: "border-primary/30 bg-primary/10 text-primary",
  researching: "border-primary/30 bg-primary/10 text-primary",
  "building-now": "border-primary/30 bg-primary/10 text-primary",
  "building-paused": "border-primary/30 bg-primary/10 text-primary",
  dormant: "border-primary/30 bg-primary/10 text-primary",
  blocked: "border-primary/30 bg-primary/10 text-primary",
  shipped: "border-primary/30 bg-primary/10 text-primary",
  archived: "border-primary/30 bg-primary/10 text-primary",
};

const posts = await getPosts();
const recentPosts = posts.slice(0, 2);
const orgs = await getCollection("orgs");
const projects = (await getCollection("projects")).filter(
  (project) =>
    project.id !== "astro-theme-breeze" &&
    !ignoredRepoSet.has(String(project.data.repo || "").toLowerCase()),
);
const journals = await getCollection("projectJournal");

const latestJournals = [...journals]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2)
  .map((entry, index) => ({
    entry,
    art: cardArt[(index + 5) % cardArt.length],
  }));

const timelineProjects = [...projects]
  .sort(
    (a, b) =>
      projectDateValue(b.data.startDate || b.data.updatedAt) -
      projectDateValue(a.data.startDate || a.data.updatedAt),
  )
  .slice(0, 4);

const featuredProject =
  [...projects].find(
    (project) =>
      !["archived", "shipped"].includes(
        normalizeStatus(project.data.status || "idea"),
      ),
  ) || projects[0];

const pendingByStatus: Record<string, string> = {
  idea: "scoping the next prototype and narrowing the design goals.",
  researching:
    "checking parts, constraints, and feasibility before the next build.",
  "building-now":
    "finishing the current prototype and validating the full system.",
  "building-paused":
    "revisiting the prototype once the next constraint is clear.",
  dormant:
    "deciding whether to revive it or carry the idea forward in a newer build.",
  blocked: "clearing the dependency or bottleneck before continuing.",
  shipped:
    "wrapping up the lessons learned and turning them into a cleaner next version.",
  archived:
    "extracting the parts worth keeping and deciding what should carry forward.",
};
---

<section>
  <div class="mb-5 flex items-center justify-between">
    <p
      class="text-[11px] font-bold tracking-[0.4em] text-muted-foreground uppercase opacity-60"
    >
      Current Focus
    </p>
  </div>

  <div class="grid gap-3 md:grid-cols-2">
    <article
      class="decor-panel decor-soft rounded-2xl border border-border bg-card p-5 md:col-span-2"
      style="--card-art: url('/assets/cards/tiles.jpg');"
    >
      <div class="mb-4 flex items-center justify-between gap-3">
        <p
          class="text-sm font-black tracking-wider text-muted-foreground uppercase"
        >
          Project Timeline
        </p>
        <a
          href="/projects"
          class="text-xs font-semibold text-primary hover:underline"
        >
          View all projects →
        </a>
      </div>

      <div
        class="relative space-y-4 before:absolute before:top-0 before:bottom-0 before:left-[0.45rem] before:w-px before:bg-border/80"
      >
        {
          timelineProjects.map((project, index) => {
            const statusKey = normalizeStatus(project.data.status || "idea");
            const statusText = statusLabelMap[statusKey] || "Idea";
            const lessonsLearned =
              project.data.lessonsLearned ||
              project.data.statusNote ||
              "Core concept validated and the main constraints are clearer now.";
            const pending =
              project.data.pending ||
              pendingByStatus[statusKey] ||
              "clarifying the next milestone and turning the concept into a more reliable build.";

            return (
              <div class="relative pl-7">
                <span class="absolute top-1.5 left-0 inline-flex h-4 w-4 items-center justify-center rounded-full border border-primary/60 bg-primary/10">
                  <span class="h-2 w-2 rounded-full bg-primary" />
                </span>
                <div class="rounded-xl border border-border/70 bg-muted/20 p-3">
                  <div class="mb-2 flex items-center justify-between gap-3">
                    <p class="text-base font-bold text-foreground">
                      {project.data.title}
                    </p>
                    <span
                      class={`rounded-full border px-2 py-0.5 text-[10px] font-medium ${statusClassMap[statusKey] || "border-border bg-background/60 text-muted-foreground"}`}
                    >
                      {statusText}
                    </span>
                  </div>
                  <p class="mb-2 text-sm text-muted-foreground">
                    {project.data.description || "An active build in progress."}
                  </p>
                  <div class="space-y-2 text-sm">
                    <p>
                      <span class="font-semibold text-foreground">
                        what i learned so far:
                      </span>{" "}
                      <span class="text-muted-foreground">
                        {lessonsLearned}
                      </span>
                    </p>
                    <p>
                      <span class="font-semibold text-foreground">
                        what's pending:
                      </span>{" "}
                      <span class="text-muted-foreground">{pending}</span>
                    </p>
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </article>

    <a
      href="/projects"
      class="decor-panel decor-soft rounded-2xl border border-border bg-card p-5 transition-all hover:-translate-y-0.5 hover:border-primary/40"
      style="--card-art: url('/assets/cards/orangerays.jpg');"
    >
      <p
        class="mb-2 text-sm font-black tracking-wider text-muted-foreground uppercase"
      >
        Current build
      </p>
      <p class="mb-3 text-2xl font-black text-foreground">
        {featuredProject?.data.title || "Open project board"}
      </p>
      <p class="mb-4 text-sm leading-relaxed text-muted-foreground">
        {
          featuredProject?.data.description ||
            "This is the current thread of work I’m pushing the most."
        }
      </p>
      <div class="rounded-xl border border-border/70 bg-muted/25 p-3">
        <p
          class="text-[10px] font-bold tracking-[0.28em] text-muted-foreground uppercase"
        >
          learning focus
        </p>
        <p class="mt-2 text-sm font-medium text-foreground">
          {
            featuredProject?.data.statusNote ||
              "Designing for feasibility, signal integrity, and prototype iteration."
          }
        </p>
      </div>
    </a>

    <a
      href="/about"
      class="decor-panel decor-soft rounded-2xl border border-border bg-card p-5 transition-all hover:-translate-y-0.5 hover:border-primary/40"
      style="--card-art: url('/assets/cards/fishes.jpg');"
    >
      <p
        class="mb-2 text-sm font-black tracking-wider text-muted-foreground uppercase"
      >
        Career direction
      </p>
      <p class="text-base font-medium text-muted-foreground">{about.intro}</p>
    </a>

    <article
      class="decor-panel decor-soft rounded-2xl border border-border bg-card p-5 transition-all hover:-translate-y-0.5 hover:border-primary/40"
      style="--card-art: url('/assets/cards/flowers.jpg');"
    >
      <p
        class="mb-2 text-sm font-black tracking-wider text-muted-foreground uppercase"
      >
        Experience + involvement
      </p>
      <p class="mb-3 text-base font-medium text-muted-foreground">
        student org leadership, internships, and hands-on engineering work that
        shaped the way I build.
      </p>
      <div class="space-y-2 rounded-xl border border-border/70 bg-muted/20 p-3">
        <p class="text-base font-bold text-foreground">IEEE UH</p>
        <p class="text-sm text-muted-foreground">
          workshop design, technical outreach, and helping students build
          practical skills.
        </p>
      </div>
      <div class="mt-3 rounded-xl border border-border/70 bg-muted/20 p-3">
        <p class="text-base font-bold text-foreground">Internships</p>
        <p class="text-sm text-muted-foreground">
          applied engineering work, systems thinking, and learning how technical
          work fits into a team.
        </p>
      </div>
    </article>

    <a
      href="/orgs"
      class="decor-panel decor-soft rounded-2xl border border-border bg-card p-5 transition-all hover:-translate-y-0.5 hover:border-primary/40"
      style="--card-art: url('/assets/cards/fishes.jpg');"
    >
      <p
        class="mb-2 text-sm font-black tracking-wider text-muted-foreground uppercase"
      >
        Organizations
      </p>
      <p class="mb-3 text-base font-medium text-muted-foreground">
        {orgs.length} organizations tracked
      </p>
      {
        orgs.length > 0 && (
          <div class="rounded-lg border border-border/70 bg-muted/30 px-3 py-2">
            <p class="text-base font-bold text-foreground">
              {orgs[0].data.title}
            </p>
            <p class="text-sm font-medium text-muted-foreground">
              {orgs[0].data.positions.length} role(s)
            </p>
          </div>
        )
      }
    </a>

    <section
      class="decor-panel decor-soft rounded-2xl border border-border bg-card p-5 transition-all hover:-translate-y-0.5 hover:border-primary/40"
      style="--card-art: url('/assets/cards/gratitude.jpg');"
    >
      <p
        class="mb-2 text-sm font-black tracking-wider text-muted-foreground uppercase"
      >
        Notes
      </p>
      <p class="mb-3 text-base font-medium text-muted-foreground">
        {posts.length} published notes
      </p>
      <div class="space-y-2">
        {
          recentPosts.map((post) => (
            <div class="rounded-lg border border-border/70 bg-muted/30 px-3 py-2">
              <p class="text-base font-bold text-foreground">
                {post.data.title}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <section
      class="decor-panel decor-soft rounded-2xl border border-border bg-card p-5 transition-all hover:-translate-y-0.5 hover:border-primary/40"
      style="--card-art: url('/assets/cards/wistygoldfish.jpg');"
    >
      <p
        class="mb-2 text-sm font-black tracking-wider text-muted-foreground uppercase"
      >
        Project journals
      </p>
      <p class="mb-3 text-base font-medium text-muted-foreground">
        {journals.length} development notes
      </p>
      <div class="space-y-2">
        {
          latestJournals.map(({ entry, art }) => (
            <div
              class="decor-panel decor-soft rounded-lg border border-border/70 bg-muted/30 px-3 py-2"
              style={`--card-art: url('${art}');`}
            >
              <a
                href={`/journals/${entry.id}`}
                class="text-base font-bold text-foreground hover:text-primary hover:underline"
              >
                {entry.data.title}
              </a>
              <p class="text-sm font-medium text-muted-foreground">
                {entry.data.projectSlug}
              </p>
            </div>
          ))
        }
      </div>
      <a
        href="/posts#journal-list"
        class="mt-4 inline-flex rounded-full border border-border bg-muted/20 px-3 py-1.5 text-xs text-muted-foreground transition-colors hover:border-primary/40 hover:text-primary"
      >
        Browse all journals
      </a>
    </section>
  </div>
</section>
