---
interface Props {
  repo: string;
}

const { repo } = Astro.props;
const repoUrl = repo.startsWith("http") ? repo : `https://github.com/${repo}`;
---

<section
  class="dark:bg-bg-secondary-dark mb-8 rounded-2xl border border-primary/15 bg-white/80 p-6 backdrop-blur-sm"
>
  <h2 class="font-brand mb-3 text-2xl text-neutral-900 dark:text-white">
    Project Links
  </h2>
  <div class="flex flex-wrap gap-3">
    <a
      href={repoUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="dark:text-primary-light inline-flex items-center rounded-full border border-primary/30 px-4 py-2 text-sm font-medium text-primary transition-colors hover:bg-primary hover:text-white"
    >
      View on GitHub
    </a>
  </div>
</section>
