---
interface Props {
  repo: string;
}

const { repo } = Astro.props;
const repoUrl = repo.startsWith("http") ? repo : `https://github.com/${repo}`;
---

<section
  class="mb-8 rounded-2xl border border-primary/25 bg-card/70 p-6 backdrop-blur-sm"
>
  <h2 class="font-brand mb-3 text-2xl text-foreground">Project Links</h2>
  <div class="flex flex-wrap gap-3">
    <a
      href={repoUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center rounded-full border border-primary/30 px-4 py-2 text-sm font-medium text-primary transition-colors hover:bg-primary hover:text-primary-foreground"
    >
      View on GitHub
    </a>
  </div>
</section>
