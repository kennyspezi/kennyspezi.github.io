---
import Sidebar from "@/components/layout/Sidebar.astro";
import Footer from "@/components/layout/Footer.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { HeadProps } from "@/types";

type Props = HeadProps & {
  compactSidebar?: boolean;
  fixedContent?: boolean;
};

const head = Astro.props;
const compactSidebar = Astro.props.compactSidebar === true;
const fixedContent = Astro.props.fixedContent === true;
---

<BaseLayout {...head}>
  <div class="flex h-full w-full max-w-full flex-col md:max-w-[94vw]">
    <div
      class="relative flex min-h-0 w-full flex-1 flex-col overflow-hidden rounded-none border border-border bg-card shadow-main md:flex-row md:rounded-[2.5rem]"
    >
      <Sidebar compact={compactSidebar} />

      <main
        class:list={[
          "custom-scrollbar flex min-h-0 min-w-0 flex-1 flex-col overflow-x-hidden overflow-y-auto",
        ]}
      >
        <div class="min-h-0 flex-1">
          <slot />
        </div>
      </main>
    </div>

    <div class="px-6 pb-3 md:px-10 md:pb-4">
      <Footer />
    </div>
  </div>
</BaseLayout>
