---
import Sidebar from "@/components/layout/Sidebar.astro";
import Footer from "@/components/layout/Footer.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { HeadProps } from "@/types";

type Props = HeadProps & {
  compactSidebar?: boolean;
};

const head = Astro.props;
const compactSidebar = Astro.props.compactSidebar === true;
---

<BaseLayout {...head}>
  <div
    class="relative flex h-auto w-full max-w-full min-w-0 flex-col overflow-hidden rounded-none border border-border bg-card shadow-main md:max-w-[75vw] md:flex-row md:rounded-[2.5rem]"
  >
    <Sidebar compact={compactSidebar} />

    <main
      class="custom-scrollbar flex flex-1 flex-col overflow-x-hidden overflow-y-auto md:h-[75vh]"
    >
      <div class="flex-1">
        <slot />
      </div>
      <div class="px-6 pb-6 md:px-10 md:pb-8">
        <Footer />
      </div>
    </main>
  </div>
</BaseLayout>
