---
import Head from "@/components/layout/Head.astro";
import type { HeadProps } from "@/types";
import "@/styles/global.css";
import Umami from "@/components/analytics/Umami.astro";
import site from "@/config/site";

type Props = HeadProps;

const head = Astro.props;
---

<html lang={site.meta.lang} class="dark">
  <Head {...head} />
  <body
    class="cute-theme-bg flex h-screen items-center justify-center overflow-hidden bg-background p-2 font-display text-foreground antialiased selection:bg-primary/20 md:p-4"
  >
    <slot />

    <Umami />
  </body>
</html>
