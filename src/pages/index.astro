---
import site from "@/config/site";
import Layout from "@/layouts/Layout.astro";
import about from "@/content/data/about.json";
import { Icon } from "astro-icon/components";

const socialButtons = site.social.filter((item) => item.name !== "Email");

const destinations = [
  {
    title: "Project Timeline",
    subtitle: "Technical Work",
    description:
      "A working record of hardware, embedded, aerospace, robotics, and sensing projects.",
    href: "/projects",
    icon: "mdi:timeline-outline",
    className: "border-primary/35 hover:border-primary/60",
  },
  {
    title: "Community Involvement",
    subtitle: "Leadership + Teaching",
    description:
      "The organizations, workshops, and people-centered engineering work I have helped build.",
    href: "/community",
    icon: "mdi:account-group-outline",
    className: "border-primary/35 hover:border-primary/60",
  },
  {
    title: "Professional Development",
    subtitle: "Career Direction",
    description:
      "Internship lessons, semester goals, and the technical direction I am narrowing toward.",
    href: "/professional-development",
    icon: "mdi:compass-outline",
    className: "border-primary/35 hover:border-primary/60",
  },
];
---

<Layout
  title={site.meta.title}
  description={site.meta.description}
  fixedContent={true}
>
  <div
    class="animate-in fade-in slide-in-from-bottom-4 mx-auto grid h-full min-h-0 w-full max-w-7xl items-center gap-8 p-6 duration-700 md:grid-cols-[1.05fr_0.95fr] md:p-10 xl:gap-12 xl:p-14"
  >
    <header class="max-w-3xl min-w-0">
      <p
        class="mb-2 text-[11px] font-semibold tracking-[0.28em] text-muted-foreground uppercase"
      >
        About Me
      </p>
      <h1
        class="mb-2 text-3xl font-black tracking-tight text-foreground md:text-4xl xl:text-[3.05rem]"
      >
        {about.profile.name}
      </h1>
      <p class="mb-3 text-sm font-semibold text-primary md:text-base">
        {about.profile.pronouns} · {about.profile.location}
      </p>
      <p
        class="mb-4 max-w-2xl text-sm leading-relaxed text-muted-foreground md:text-base"
      >
        {about.intro}
      </p>

      <div class="flex flex-wrap gap-3">
        <a
          href={about.buttons.resumeHref || site.meta.resume}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full border border-primary/35 bg-primary/10 px-4 py-2 text-sm font-semibold text-primary transition-colors hover:border-primary/50 hover:bg-primary/15"
        >
          <Icon name="mdi:file-document-outline" class="h-4 w-4" />
          {about.buttons.resumeLabel}
        </a>

        <a
          href={about.buttons.emailHref}
          class="inline-flex items-center gap-2 rounded-full border border-border bg-muted/25 px-4 py-2 text-sm font-semibold text-foreground transition-colors hover:border-primary/35 hover:text-primary"
        >
          <Icon name="mdi:email-outline" class="h-4 w-4" />
          {about.buttons.emailLabel}
        </a>

        {
          socialButtons.map((item) => (
            <a
              href={item.href}
              target={item.href.startsWith("http") ? "_blank" : undefined}
              rel={
                item.href.startsWith("http") ? "noopener noreferrer" : undefined
              }
              class="inline-flex items-center gap-2 rounded-full border border-border bg-muted/25 px-4 py-2 text-sm font-semibold text-foreground transition-colors hover:border-primary/35 hover:text-primary"
            >
              <Icon name={item.icon} class="h-4 w-4" />
              {item.name}
            </a>
          ))
        }
      </div>
    </header>

    <nav aria-label="Portfolio sections" class="min-h-0 overflow-y-auto pr-1">
      <div class="grid gap-3 sm:grid-cols-2">
        {
          destinations.map((destination, index) => (
            <a
              href={destination.href}
              class={`group relative overflow-hidden rounded-2xl border bg-card/75 p-5 transition-all duration-300 hover:-translate-y-1 hover:bg-card ${destination.className}`}
              style={`animation-delay: ${index * 100}ms`}
            >
              <div class="mb-5 flex items-start justify-between gap-4">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary">
                  <Icon name={destination.icon} class="h-7 w-7" />
                </div>
                <span class="text-sm font-bold text-muted-foreground transition-colors group-hover:text-primary">
                  Open →
                </span>
              </div>
              <p class="mb-2 text-xs font-bold tracking-[0.25em] text-muted-foreground uppercase">
                {destination.subtitle}
              </p>
              <h2 class="mb-2 text-xl font-black text-foreground md:text-2xl">
                {destination.title}
              </h2>
              <p class="max-w-xl text-base leading-relaxed text-muted-foreground">
                {destination.description}
              </p>
            </a>
          ))
        }
        {
          about.homeGif ? (
            <img
              src={about.homeGif}
              alt=""
              class="h-full min-h-32 w-full rounded-2xl border border-border object-cover"
            />
          ) : (
            <div class="flex min-h-32 items-center justify-center rounded-2xl border border-dashed border-border bg-muted/15 text-sm font-medium text-muted-foreground">
              GIF placeholder
            </div>
          )
        }
      </div>
    </nav>
  </div>
</Layout>
