---
import Hero from "@/components/blocks/Hero.astro";
import HomeBento from "@/components/blocks/HomeBento.astro";
import site from "@/config/site";
import Layout from "@/layouts/Layout.astro";
---

<Layout title={site.meta.title} description={site.meta.description}>
  <div
    class="animate-in fade-in slide-in-from-bottom-4 mx-auto max-w-4xl space-y-8 p-8 md:space-y-10 md:p-16"
  >
    <Hero />

    <HomeBento />
  </div>
</Layout>
