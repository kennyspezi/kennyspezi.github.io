---
import site from "@/config/site";
import Layout from "@/layouts/Layout.astro";
import about from "@/content/data/about.json";
import { Icon } from "astro-icon/components";

const playlistEmbed = about.playlist?.embedUrl?.trim() || "";
const playlistFallback = about.playlist?.fallbackLink?.trim() || "";
const playlistTitle = about.playlist?.title?.trim() || "Playlist";
const playlistDescription = about.playlist?.description?.trim() || "";
const storyHeading = about.story?.heading?.trim() || "A Little More About Me";
const storyParagraphs = about.story?.paragraphs || [];
const socialButtons = site.social.filter((item) => item.name !== "Email");
const featuredFacts = (about.funFacts || []).slice(0, 2);
const extraFacts = (about.funFacts || []).slice(2);
const primaryCards = (about.infoCards || []).slice(0, 2);
const extraCards = (about.infoCards || []).slice(2);
const musicPreview = (about.favorites?.music || []).slice(0, 3);
---

<Layout
  title={site.labels.aboutTitle}
  description={site.labels.aboutDescription}
>
  <div
    class="animate-in fade-in mx-auto max-w-5xl p-6 duration-700 md:p-8 xl:p-10"
  >
    <section
      class="decor-panel decor-soft mb-5 rounded-3xl border border-border bg-card/80 p-5 backdrop-blur-sm md:p-6"
      style="--card-art: url('/assets/cards/sunrug.jpg');"
    >
      <div class="grid gap-5 lg:grid-cols-[1.35fr_0.95fr] lg:items-start">
        <div>
          <p
            class="mb-2 text-[11px] font-semibold tracking-[0.28em] text-muted-foreground uppercase"
          >
            About Me
          </p>
          <h1
            class="mb-2 text-3xl font-black tracking-tight text-foreground md:text-4xl xl:text-[3.05rem]"
          >
            {about.profile.name}
          </h1>
          <p class="mb-3 text-sm font-semibold text-primary md:text-base">
            {about.profile.pronouns} · {about.profile.location}
          </p>
          <p
            class="mb-4 max-w-3xl text-base leading-relaxed text-muted-foreground md:text-lg"
          >
            {about.intro}
          </p>

          <div class="flex flex-wrap gap-3">
            <a
              href={about.buttons.resumeHref || site.meta.resume}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-full border border-primary/35 bg-primary/10 px-4 py-2 text-sm font-semibold text-primary transition-colors hover:border-primary/50 hover:bg-primary/15"
            >
              <Icon name="mdi:file-document-outline" class="h-4 w-4" />
              {about.buttons.resumeLabel}
            </a>

            <a
              href={about.buttons.emailHref}
              class="inline-flex items-center gap-2 rounded-full border border-border bg-muted/25 px-4 py-2 text-sm font-semibold text-foreground transition-colors hover:border-primary/35 hover:text-primary"
            >
              <Icon name="mdi:email-outline" class="h-4 w-4" />
              {about.buttons.emailLabel}
            </a>

            {
              socialButtons.map((item) => (
                <a
                  href={item.href}
                  target={item.href.startsWith("http") ? "_blank" : undefined}
                  rel={
                    item.href.startsWith("http")
                      ? "noopener noreferrer"
                      : undefined
                  }
                  class="inline-flex items-center gap-2 rounded-full border border-border bg-muted/25 px-4 py-2 text-sm font-semibold text-foreground transition-colors hover:border-primary/35 hover:text-primary"
                >
                  <Icon name={item.icon} class="h-4 w-4" />
                  {item.name}
                </a>
              ))
            }
          </div>
        </div>

        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
          {
            featuredFacts.map((fact) => (
              <div class="rounded-2xl border border-border bg-background/55 p-4">
                <p class="mb-1 text-[11px] font-semibold tracking-[0.22em] text-muted-foreground uppercase">
                  {fact.label}
                </p>
                <p class="text-sm leading-relaxed font-semibold text-foreground">
                  {fact.value}
                </p>
              </div>
            ))
          }

          {
            primaryCards.map((card, index) => (
              <article
                class="decor-panel rounded-2xl border border-border bg-background/55 p-4"
                style={`--card-art: url('${
                  ["/assets/cards/flowers.jpg", "/assets/cards/gratitude.jpg"][
                    index % 2
                  ]
                }');`}
              >
                <h2 class="mb-2 text-lg font-black tracking-tight text-foreground">
                  {card.title}
                </h2>
                <p class="text-sm leading-relaxed font-medium text-muted-foreground">
                  {card.body}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {
      (extraFacts.length > 0 || extraCards.length > 0) && (
        <section class="mb-5 grid gap-3 lg:grid-cols-3">
          {extraFacts.map((fact) => (
            <article class="rounded-2xl border border-border bg-card/80 p-4 backdrop-blur-sm">
              <p class="mb-1 text-[11px] font-semibold tracking-[0.22em] text-muted-foreground uppercase">
                {fact.label}
              </p>
              <p class="text-sm leading-relaxed font-semibold text-foreground">
                {fact.value}
              </p>
            </article>
          ))}

          {extraCards.map((card, index) => (
            <article
              class="decor-panel rounded-2xl border border-border bg-card/80 p-4 backdrop-blur-sm"
              style={`--card-art: url('${
                [
                  "/assets/cards/wistygoldfish.jpg",
                  "/assets/cards/tiles.jpg",
                  "/assets/cards/orangerays.jpg",
                ][index % 3]
              }');`}
            >
              <h2 class="mb-2 text-lg font-black tracking-tight text-foreground">
                {card.title}
              </h2>
              <p class="text-sm leading-relaxed font-medium text-muted-foreground">
                {card.body}
              </p>
            </article>
          ))}
        </section>
      )
    }

    <section class="grid items-start gap-3 lg:grid-cols-[0.95fr_1.05fr]">
      <article
        class="decor-panel decor-soft rounded-3xl border border-border bg-card/80 p-5 backdrop-blur-sm"
        style="--card-art: url('/assets/cards/tiles.jpg');"
      >
        <h2 class="mb-3 text-xl font-black tracking-tight text-foreground">
          {storyHeading}
        </h2>
        <div class="space-y-3">
          {
            storyParagraphs.map((paragraph) => (
              <p class="text-sm leading-relaxed font-medium text-muted-foreground md:text-base">
                {paragraph}
              </p>
            ))
          }
        </div>
      </article>

      {
        playlistEmbed ? (
          <iframe
            title={playlistTitle}
            src={playlistEmbed}
            width="100%"
            height="400"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy"
            class="block h-[400px] w-full self-start overflow-hidden rounded-3xl border border-border bg-card/80"
            style="border: 0; border-radius: 1.5rem;"
          />
        ) : (
          <article
            class="decor-panel decor-soft rounded-3xl border border-border bg-card/80 p-5 backdrop-blur-sm"
            style="--card-art: url('/assets/cards/orangerays.jpg');"
          >
            <div class="mb-3 flex items-start justify-between gap-3">
              <div>
                <h2 class="text-xl font-black tracking-tight text-foreground">
                  {playlistTitle}
                </h2>
                {playlistDescription && (
                  <p class="mt-1 text-sm font-medium text-muted-foreground">
                    {playlistDescription}
                  </p>
                )}
              </div>

              {musicPreview.length > 0 && (
                <div class="hidden rounded-2xl border border-border bg-background/45 px-3 py-2 md:block">
                  <p class="text-[11px] font-semibold tracking-[0.22em] text-muted-foreground uppercase">
                    On Repeat
                  </p>
                  <p class="mt-1 text-sm font-semibold text-foreground">
                    {musicPreview.slice(0, 2).join(" · ")}
                  </p>
                </div>
              )}
            </div>

            {playlistFallback ? (
              <a
                href={playlistFallback}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-full border border-primary/35 bg-primary/10 px-4 py-2 text-sm font-semibold text-primary transition-colors hover:border-primary/50 hover:bg-primary/15"
              >
                <Icon name="mdi:spotify" class="h-4 w-4" />
                Open playlist
              </a>
            ) : (
              <div class="rounded-2xl border border-dashed border-border bg-muted/15 p-4 text-sm text-muted-foreground">
                Add a Spotify embed URL or fallback link in
                <span class="mx-1 font-mono">src/content/data/about.json</span>.
              </div>
            )}
          </article>
        )
      }
    </section>
  </div>
</Layout>
