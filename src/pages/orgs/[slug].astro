---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import projectOverrides from "@/content/data/project-overrides.json";
import { applyProjectOverride } from "@/utils/project-normalize";

export async function getStaticPaths() {
  const orgs = await getCollection("orgs");
  return orgs.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const orgSummaries = await getCollection("orgSummaries");
const orgSummary = orgSummaries.find(
  (summary) => summary.data.slug === entry.data.slug,
);
const renderedSummary = orgSummary ? await render(orgSummary) : null;
const SummaryContent = renderedSummary?.Content;
const allProjects = await getCollection("projects");
const tagEntries = await getCollection("tags");
const knownTagSlugs = new Set(tagEntries.map((tag) => tag.id));
const relatedProjects = allProjects.filter((project) =>
  (entry.data.relatedProjects || []).includes(project.id),
);
---

<Layout title={entry.data.title} description={entry.data.description}>
  <div
    class="animate-in fade-in mx-auto max-w-6xl p-8 duration-700 md:p-12 xl:p-16"
  >
    <header
      class="mb-10 rounded-3xl border border-primary/15 bg-card/70 p-8 backdrop-blur-sm md:p-10"
    >
      <div
        class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between"
      >
        <div class="max-w-4xl">
          <div class="mb-4 flex items-center gap-4">
            {
              entry.data.logo ? (
                <img
                  src={entry.data.logo}
                  alt={`${entry.data.title} logo`}
                  loading="lazy"
                  class="h-18 w-18 rounded-2xl border border-primary/15 bg-background/40 object-cover p-2"
                />
              ) : (
                <div class="flex h-18 w-18 items-center justify-center rounded-2xl border border-primary/15 bg-primary/8 text-2xl font-black text-primary">
                  {entry.data.title.charAt(0)}
                </div>
              )
            }

            <div>
              <p
                class="mb-2 text-xs font-semibold tracking-[0.28em] text-muted-foreground uppercase"
              >
                Organization
              </p>
              <h1 class="text-4xl font-black tracking-tight md:text-5xl">
                {entry.data.title}
              </h1>
            </div>
          </div>
          <p
            class="max-w-3xl text-base leading-relaxed text-muted-foreground md:text-lg"
          >
            {entry.data.description}
          </p>
        </div>

        <div class="flex flex-wrap gap-2 md:max-w-xs md:justify-end">
          {
            entry.data.tags.map((tag) => (
              <span class="rounded-full border border-border bg-muted/25 px-3 py-1 text-xs font-semibold text-muted-foreground">
                {tag}
              </span>
            ))
          }
        </div>
      </div>
    </header>

    {
      entry.data.website && (
        <p class="mb-8 text-sm">
          <a
            href={entry.data.website}
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary hover:underline"
          >
            Organization Website
          </a>
        </p>
      )
    }

    {
      entry.data.heroImage && (
        <div class="mb-10 overflow-hidden rounded-3xl border border-primary/15 bg-card/60">
          <img
            src={entry.data.heroImage}
            alt={`${entry.data.title} feature image`}
            loading="lazy"
            class="h-56 w-full object-cover md:h-72"
          />
        </div>
      )
    }

    {
      entry.data.repoLinks.length > 0 && (
        <section class="mb-10">
          <h2 class="mb-3 text-2xl font-bold">Organization Repositories</h2>
          <ul class="space-y-2">
            {entry.data.repoLinks.map((link) => (
              <li>
                <a
                  href={link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-primary hover:underline"
                >
                  {link}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="mb-10">
      <h2 class="mb-3 text-2xl font-bold">Timeline</h2>
      {
        entry.data.positions.length === 0 ? (
          <p class="text-sm text-muted-foreground">No positions added yet.</p>
        ) : (
          <ol
            class="timeline-grid gap-4 md:gap-6"
            style={`--timeline-columns: ${Math.max(entry.data.positions.length, 1)};`}
          >
            {entry.data.positions.map((position, index) => (
              <li class="relative rounded-2xl border border-primary/15 bg-card/60 p-5 backdrop-blur-sm">
                <div class="mb-4 flex items-center gap-3">
                  <span class="flex h-10 w-10 items-center justify-center rounded-full border border-primary/25 bg-primary/10 text-sm font-black text-primary">
                    {index + 1}
                  </span>
                  <div>
                    <p class="text-lg font-bold">{position.title}</p>
                    <p class="text-xs font-medium text-muted-foreground/80">
                      {position.startDate.toLocaleDateString("en-US", {
                        year: "numeric",
                        month: "short",
                      })}{" "}
                      –{" "}
                      {position.endDate
                        ? position.endDate.toLocaleDateString("en-US", {
                            year: "numeric",
                            month: "short",
                          })
                        : "Present"}
                    </p>
                  </div>
                </div>
                {position.summary && (
                  <p class="text-sm leading-relaxed text-muted-foreground">
                    {position.summary}
                  </p>
                )}
              </li>
            ))}
          </ol>
        )
      }
    </section>

    {
      orgSummary && (
        <section class="rounded-3xl border border-primary/15 bg-muted/20 p-6 md:p-8">
          <h2 class="mb-3 text-2xl font-bold">
            {orgSummary.data.title || "Overview"}
          </h2>

          {SummaryContent && (
            <div class="prose max-w-none dark:prose-invert">
              <SummaryContent />
            </div>
          )}

          {orgSummary.data.embedUrl && (
            <div class="mt-4 overflow-hidden rounded-xl border border-primary/15">
              <iframe
                src={orgSummary.data.embedUrl}
                title={`${entry.data.title} resources`}
                class="h-[560px] w-full"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              />
            </div>
          )}
        </section>
      )
    }

    {
      relatedProjects.length > 0 && (
        <section class="mt-10 mb-10">
          <div class="mb-4 flex items-end justify-between gap-4">
            <div>
              <h2 class="mb-2 text-2xl font-bold">Related Projects</h2>
              <p class="text-sm text-muted-foreground">
                Projects tied to this org through teams, events, or workshop
                work.
              </p>
            </div>
            <p class="text-xs text-muted-foreground">
              Set these in{" "}
              <span class="font-mono">src/content/orgs/{entry.id}.json</span>{" "}
              with <span class="font-mono">relatedProjects</span>.
            </p>
          </div>

          <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            {relatedProjects.map((project) => (
              <ProjectCard
                project={applyProjectOverride(
                  {
                    slug: project.id,
                    title: project.data.title,
                    description: project.data.description || "",
                    status: project.data.status,
                    statusNote: project.data.statusNote,
                    contributorsWanted:
                      project.data.contributorsWanted ?? false,
                    tech: project.data.tech || [],
                    tags: project.data.tags || [],
                    commits: project.data.commits || [],
                    previewImage: project.data.previewImage,
                    images: project.data.images || [],
                    isFork: project.data.isFork,
                    forkedFrom: project.data.forkedFrom,
                    forkedFromUrl: project.data.forkedFromUrl,
                    hackathonName: project.data.hackathonName,
                    hackathonUrl: project.data.hackathonUrl,
                    replacementLabel: project.data.replacementLabel,
                    replacementUrl: project.data.replacementUrl,
                    buildsOnLabels: project.data.buildsOnLabels || [],
                    buildsOnUrls: project.data.buildsOnUrls || [],
                    cardEmoji: project.data.cardEmoji,
                    repo: project.data.repo,
                    links: project.data.links || {},
                  },
                  projectOverrides,
                )}
              />
            ))}
          </div>
        </section>
      )
    }
  </div>
</Layout>

<style>
  .timeline-grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .timeline-grid {
      grid-template-columns: repeat(var(--timeline-columns), minmax(0, 1fr));
    }
  }
</style>
