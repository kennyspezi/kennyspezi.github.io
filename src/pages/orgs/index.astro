---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import siteImages from "@/content/data/site-images.json";

const orgs = await getCollection("orgs");
const tagEntries = await getCollection("tags");
const knownTagSlugs = new Set(tagEntries.map((tag) => tag.id));
const heroImage = (siteImages.orgs || [])[0];
const sortedOrgs = [...orgs].sort((a, b) => {
  const aDate = a.data.positions?.[0]?.startDate
    ? new Date(a.data.positions[0].startDate).getTime()
    : 0;
  const bDate = b.data.positions?.[0]?.startDate
    ? new Date(b.data.positions[0].startDate).getTime()
    : 0;
  return bDate - aDate;
});
---

<Layout
  title="Organizations"
  description="Groups, communities, and teams I build with."
>
  <div
    class="animate-in fade-in mx-auto max-w-6xl p-8 duration-700 md:p-12 xl:p-16"
  >
    <section class="relative mb-8 overflow-hidden rounded-3xl">
      {
        heroImage?.src && (
          <>
            <img
              src={heroImage.src}
              alt={heroImage.alt || ""}
              loading="lazy"
              class="absolute inset-0 h-full w-full object-cover opacity-20"
            />
            <div
              class="absolute inset-0"
              style="background: linear-gradient(180deg, rgba(12, 16, 37, 0.12) 0%, rgba(12, 16, 37, 0.7) 70%, rgba(12, 16, 37, 0.88) 100%);"
            />
          </>
        )
      }

      <div class="relative z-10 py-6 md:py-8">
        <p
          class="mb-2 text-[11px] font-semibold tracking-[0.28em] text-muted-foreground uppercase"
        >
          Organizations
        </p>
        <h1 class="font-brand mb-2 text-3xl text-foreground md:text-4xl">
          Organizations
        </h1>
        <p
          class="max-w-2xl text-sm leading-relaxed text-muted-foreground md:text-base"
        >
          Groups, communities, and teams I build with.
        </p>
      </div>
    </section>

    {
      sortedOrgs.length === 0 ? (
        <p class="text-sm text-muted-foreground">
          No organizations yet. Add content under `src/content/orgs`.
        </p>
      ) : (
        <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {sortedOrgs.map((entry) => (
            <a
              href={`/orgs/${entry.data.slug}`}
              class="rounded-2xl border border-primary/15 bg-card/40 p-5 transition-colors hover:border-primary/35"
            >
              <div class="flex items-start gap-3">
                {entry.data.logo ? (
                  <img
                    src={entry.data.logo}
                    alt={`${entry.data.title} logo`}
                    loading="lazy"
                    class="h-16 w-16 shrink-0 rounded-lg border border-primary/15 object-cover"
                  />
                ) : (
                  <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-lg border border-primary/15 bg-primary/8 text-xl font-bold text-primary">
                    {entry.data.title.charAt(0)}
                  </div>
                )}

                <div class="min-w-0">
                  <h2 class="mb-1 text-xl font-bold text-foreground">
                    {entry.data.title}
                  </h2>
                  <p class="mb-2 text-sm text-muted-foreground">
                    {entry.data.description}
                  </p>
                  {entry.data.tags.length > 0 && (
                    <div class="mb-2 flex flex-wrap gap-1.5">
                      {entry.data.tags
                        .slice(0, 3)
                        .map((tag) =>
                          knownTagSlugs.has(tag) ? (
                            <span class="rounded-full border border-border bg-muted/20 px-2 py-0.5 text-[11px] font-medium text-muted-foreground">
                              {tag}
                            </span>
                          ) : (
                            <span class="rounded-full border border-border bg-muted/20 px-2 py-0.5 text-[11px] font-medium text-muted-foreground">
                              {tag}
                            </span>
                          ),
                        )}
                    </div>
                  )}
                  <p class="text-xs text-muted-foreground/70">
                    {entry.data.positions.length} position(s) tracked
                  </p>
                </div>
              </div>
            </a>
          ))}
        </div>
      )
    }
  </div>
</Layout>
