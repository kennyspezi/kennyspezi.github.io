---
import { getCollection } from "astro:content";
import { marked } from "marked";
import Layout from "@/layouts/Layout.astro";
import {
  applyProjectOverride,
  normalizeProject,
  projectDateValue,
} from "@/utils/project-normalize";
import ignoredRepos from "@/content/data/ignoredrepoentry.json";
import projectOverrides from "@/content/data/project-overrides.json";

const localProjects = await getCollection("projects");
let githubProjects: any[] = [];
try {
  githubProjects =
    (await import("../../content/projects/github.json")).default || [];
} catch {}

const mergeProjectData = (primary: any, secondary: any) => ({
  ...secondary,
  ...primary,
  tags: primary.tags?.length
    ? primary.tags
    : secondary.tags?.length
      ? secondary.tags
      : [],
  tech: primary.tech?.length
    ? primary.tech
    : secondary.tech?.length
      ? secondary.tech
      : [],
  links: { ...(secondary.links || {}), ...(primary.links || {}) },
  commits: primary.commits?.length
    ? primary.commits
    : secondary.commits?.length
      ? secondary.commits
      : [],
  images: primary.images?.length
    ? primary.images
    : secondary.images?.length
      ? secondary.images
      : [],
  previewImage: primary.previewImage || secondary.previewImage || "",
});

const rewriteReadmeImages = (
  markdown: string,
  repoPath: string,
  branch: string,
) =>
  markdown.replace(
    /!\[([^\]]*)\]\(([^)\s]+)(?:\s+"[^"]*")?\)/g,
    (match, alt, source) => {
      const imagePath = String(source).trim();
      if (/^(https?:|data:|\/\/)/i.test(imagePath)) return match;
      const cleanedPath = imagePath.replace(/^\.\//, "").replace(/^\//, "");
      return `![${alt}](https://raw.githubusercontent.com/${repoPath}/${branch}/${cleanedPath})`;
    },
  );

const ignoredRepoSet = new Set(
  ignoredRepos.map((item) => String(item).toLowerCase()),
);
const mergedByKey = new Map<string, any>();
const normalizedProjects = [
  ...localProjects.map((project) =>
    normalizeProject(
      applyProjectOverride(
        { ...project.data, slug: project.id },
        projectOverrides,
      ),
    ),
  ),
  ...githubProjects.map((project) =>
    normalizeProject(
      applyProjectOverride(project, projectOverrides),
      !!project.manual,
    ),
  ),
];

for (const project of normalizedProjects) {
  const repo = String(project.repo || project.links?.github || "")
    .toLowerCase()
    .replace(/^https?:\/\/github\.com\//, "");
  if (ignoredRepoSet.has(repo) || project.slug === "astro-theme-breeze")
    continue;
  const key =
    project.links?.github?.toLowerCase() ||
    project.title?.toLowerCase() ||
    project.slug;
  if (!key) continue;
  mergedByKey.set(
    key,
    mergedByKey.has(key)
      ? mergeProjectData(mergedByKey.get(key), project)
      : project,
  );
}

const timelineProjects = [...mergedByKey.values()].sort(
  (a, b) =>
    projectDateValue(b.startDate || b.updatedAt) -
    projectDateValue(a.startDate || a.updatedAt),
);

const projectsWithReadmes = await Promise.all(
  timelineProjects.map(async (project) => {
    const repo = project.links?.github;
    if (!repo) return project;

    const repoPath = new URL(repo).pathname.replace(/^\//, "");
    const fetchReadme = async () => {
      const response = await fetch(
        `https://api.github.com/repos/${repoPath}/readme`,
        {
          headers: { Accept: "application/vnd.github+json" },
        },
      );
      if (!response.ok)
        throw new Error(`README fetch failed (${response.status})`);
      const data = await response.json();
      const markdown = Buffer.from(data.content, "base64").toString("utf-8");
      const branch =
        typeof data.download_url === "string"
          ? data.download_url.match(
              /^https?:\/\/raw\.githubusercontent\.com\/[^/]+\/[^/]+\/([^/]+)\//i,
            )?.[1] || "main"
          : "main";
      return marked.parse(
        rewriteReadmeImages(markdown, repoPath, branch),
      ) as string;
    };

    // GitHub's unauthenticated API occasionally has transient failures; retry once.
    try {
      return { ...project, readmeHtml: await fetchReadme() };
    } catch {
      try {
        return { ...project, readmeHtml: await fetchReadme() };
      } catch {
        return project;
      }
    }
  }),
);
const escapeJson = (value: unknown) =>
  JSON.stringify(value).replace(/</g, "\\u003c");
---

<Layout
  title="Project Timeline"
  description="A chronological record of Kenny's hardware, embedded systems, and engineering projects."
  fixedContent={true}
>
  <div
    class="animate-in fade-in mx-auto flex h-full min-h-0 w-full max-w-[1500px] flex-col px-4 py-6 duration-700 md:px-6 md:py-8"
  >
    <div
      class="grid min-h-0 min-w-0 flex-1 gap-4 max-md:grid-rows-[auto_minmax(0,1fr)] lg:grid-cols-[minmax(20rem,0.8fr)_minmax(0,1.8fr)]"
    >
      <aside
        class="flex min-h-0 flex-col rounded-3xl border border-primary/25 bg-primary/5 p-3 max-md:max-h-[35vh] max-md:overflow-y-auto"
      >
        <header class="mb-4 shrink-0 border-b border-primary/15 px-3 pt-3 pb-4">
          <h1
            class="mb-2 text-3xl font-black tracking-tight text-foreground md:text-4xl"
          >
            My Builds
          </h1>
        </header>

        <div class="mb-3 flex shrink-0 items-center justify-between px-3 py-2">
          <p class="text-xs font-bold tracking-[0.25em] text-primary uppercase">
            Timeline
          </p><span class="text-xs text-muted-foreground"
            >{timelineProjects.length} entries</span
          >
        </div>
        <div
          class="min-h-0 flex-1 overflow-y-auto pr-1 max-md:flex-none max-md:overflow-x-auto max-md:overflow-y-hidden max-md:pb-1"
        >
          <ol
            class="space-y-2 max-md:flex max-md:w-max max-md:gap-2 max-md:space-y-0"
          >
            {
              projectsWithReadmes.map((project, index) => (
                <li class="max-md:w-[min(68vw,16rem)] max-md:flex-none">
                  <button
                    type="button"
                    title={project.title}
                    aria-label={project.title}
                    class:list={[
                      "project-timeline-item group w-full rounded-2xl border p-4 text-left transition-all hover:-translate-y-0.5 hover:border-primary/70",
                      index === 0
                        ? "is-selected border-primary/70 bg-primary/15"
                        : "border-border bg-card/65",
                    ]}
                    data-project={escapeJson(project)}
                    aria-pressed={index === 0 ? "true" : "false"}
                  >
                    <span class="mb-2 block text-xs font-bold tracking-[0.15em] text-primary uppercase">
                      {project.startDate || "Date pending"}
                    </span>
                    <span class="block text-lg font-black text-foreground group-hover:text-primary">
                      {project.cardEmoji && (
                        <span class="mr-1">{project.cardEmoji}</span>
                      )}
                      {project.title}
                    </span>
                    {project.subtitle && (
                      <span class="mt-1 block text-sm leading-snug text-muted-foreground">
                        {project.subtitle}
                      </span>
                    )}
                    <span class="mt-1 block text-sm text-muted-foreground">
                      {project.status || "idea"}
                    </span>
                  </button>
                </li>
              ))
            }
          </ol>
        </div>
      </aside>

      <section
        class="min-h-0 overflow-y-auto rounded-3xl border border-border bg-card/70 p-5 md:p-8"
      >
        <div id="project-detail-content"></div>
      </section>
    </div>
  </div>
</Layout>

<script>
  const initializeProjectTimeline = () => {
    const detail = document.querySelector<HTMLElement>(
      "#project-detail-content",
    );
    const items = Array.from(
      document.querySelectorAll<HTMLElement>(".project-timeline-item"),
    );
    if (!detail || items.length === 0) return;

    const renderProject = (project: any) => {
      const image = project.readmeHtml
        ? ""
        : project.previewImage || project.images?.[0] || "";
      const lessons = project.lessonsLearned || project.statusNote || "";
      const pending = project.pending || "";
      const checklist = Array.isArray(project.checklist)
        ? project.checklist
        : [];
      const checklistMarkup = checklist.length
        ? `<section class="mb-7"><p class="mb-3 text-xs font-bold tracking-[0.2em] text-muted-foreground uppercase">Build checklist</p><div class="flex gap-3 overflow-x-auto pb-2">${checklist
            .map((item: any, index: number) => {
              const statusClass =
                item.status === "done"
                  ? "border-primary/40 bg-primary/10"
                  : item.status === "inprogress"
                    ? "border-primary/25 bg-muted/20"
                    : "border-border bg-muted/20";
              const statusLabel =
                item.status === "done"
                  ? "Done"
                  : item.status === "inprogress"
                    ? "In progress"
                    : "To do";
              return `<div class="min-w-48 flex-1 rounded-xl border p-4 ${statusClass}"><div class="mb-2 flex items-center justify-between gap-2"><span class="text-xs font-black text-muted-foreground">${String(index + 1).padStart(2, "0")}</span><span class="text-[10px] font-bold tracking-wider text-primary uppercase">${statusLabel}</span></div><p class="text-sm font-semibold leading-snug text-foreground">${item.title}</p></div>`;
            })
            .join("")}</div></section>`
        : "";
      const github = project.links?.github
        ? `<a href="${project.links.github}" target="_blank" rel="noopener noreferrer" class="rounded-xl border border-border px-4 py-2 text-sm font-bold text-primary hover:border-primary">Open GitHub</a>`
        : "";
      const lessonsMarkup = lessons
        ? `<div class="rounded-2xl border border-border bg-muted/20 p-5"><p class="mb-2 text-xs font-bold tracking-[0.2em] text-primary uppercase">What I learned</p><p class="text-base leading-relaxed text-foreground">${lessons}</p></div>`
        : "";
      const pendingMarkup = pending
        ? `<div class="rounded-2xl border border-border bg-muted/20 p-5"><p class="mb-2 text-xs font-bold tracking-[0.2em] text-primary uppercase">What is pending</p><p class="text-base leading-relaxed text-foreground">${pending}</p></div>`
        : "";
      const readmeMarkup = project.readmeHtml
        ? `<section class="mb-7 rounded-2xl border border-border bg-muted/15 p-5"><p class="mb-4 text-xs font-bold tracking-[0.2em] text-primary uppercase">README</p><div class="article-content prose max-w-none dark:prose-invert">${project.readmeHtml}</div></section>`
        : "";
      const imageMarkup = project.readmeHtml
        ? ""
        : image
          ? `<div class="mb-7 overflow-hidden rounded-2xl border border-border bg-muted/20"><img src="${image}" alt="${project.title} preview" class="max-h-[28rem] w-full object-cover" /></div>`
          : `<div class="mb-7 flex min-h-48 items-center justify-center rounded-2xl border border-dashed border-border bg-muted/20 p-6 text-muted-foreground">Add a previewImage or images URL to this project.</div>`;
      detail.innerHTML = `<p class="mb-3 text-sm font-bold tracking-[0.25em] text-primary uppercase">Selected project</p><h2 class="mb-2 text-3xl font-black text-foreground md:text-5xl">${project.title}</h2>${project.subtitle ? `<p class="mb-4 text-xl font-semibold text-primary/90">${project.subtitle}</p>` : ""}${checklistMarkup}${lessonsMarkup || pendingMarkup ? `<div class="mb-7 grid gap-4 md:grid-cols-2">${lessonsMarkup}${pendingMarkup}</div>` : ""}${readmeMarkup}${imageMarkup}<div class="flex flex-wrap gap-3">${github}</div>`;
    };

    items.forEach((item) =>
      item.addEventListener("click", () => {
        items.forEach((candidate) => {
          candidate.classList.remove(
            "is-selected",
            "border-primary/70",
            "bg-primary/15",
          );
          candidate.classList.add("border-border", "bg-card/65");
          candidate.setAttribute("aria-pressed", "false");
        });
        item.classList.add("is-selected", "border-primary/70", "bg-primary/15");
        renderProject(JSON.parse(item.dataset.project || "{}"));
      }),
    );

    const selected: HTMLElement =
      items.find((item) => item.getAttribute("aria-pressed") === "true") ||
      items[0];
    renderProject(JSON.parse(selected.dataset.project || "{}"));
  };

  document.addEventListener("astro:page-load", initializeProjectTimeline);
</script>
