---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { getPublishedPosts } from "@/utils/post";
import site from "@/config/site";

const posts = await getPublishedPosts();
if (posts.length === 0) {
  return new Response(null, { status: 404 });
}
const renderedPosts = await Promise.all(
  posts.map(async (post) => ({ post, rendered: await render(post) })),
);
---

<Layout
  title={site.labels.postsTitle}
  description={`${site.labels.postsDescription} — ${posts.length} posts.`}
  fixedContent={true}
>
  <div
    class="animate-in fade-in mx-auto flex h-full min-h-0 w-full max-w-[1500px] flex-col px-4 py-5 duration-700 md:px-6 md:py-6"
  >
    <header
      class="mb-4 flex shrink-0 items-center justify-between border-b border-border/60 pb-4"
    >
      <div>
        <p class="text-xs font-bold tracking-[0.3em] text-primary uppercase">
          Archive
        </p><h1
          class="text-3xl font-black tracking-tight text-foreground md:text-5xl"
        >
          {site.labels.postsTitle}
        </h1>
      </div>
      <span class="text-sm text-muted-foreground">{posts.length} notes</span>
    </header>
    <div
      class="grid min-h-0 flex-1 gap-4 lg:grid-cols-[minmax(20rem,0.8fr)_minmax(0,1.8fr)]"
    >
      <aside
        class="min-h-0 overflow-y-auto rounded-3xl border border-border/60 bg-muted/10 p-3"
      >
        <div class="mb-3 px-3 py-2">
          <p class="text-xs font-bold tracking-[0.25em] text-primary uppercase">
            Notes
          </p><p class="mt-1 text-sm text-muted-foreground">
            Select a note to read.
          </p>
        </div>
        <div class="space-y-2">
          {
            posts.map((post) => (
              <button
                type="button"
                class="note-select group w-full rounded-2xl border border-border bg-card/65 p-4 text-left transition-all hover:-translate-y-0.5 hover:border-primary/60"
                data-note-id={post.id}
                aria-pressed="false"
              >
                <span class="block text-lg font-black text-foreground group-hover:text-primary">
                  {post.data.title}
                </span>
                <span class="mt-1 block text-sm text-muted-foreground">
                  {post.data.createdAt.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                  })}
                </span>
                {post.data.summary && (
                  <span class="mt-2 block text-sm leading-relaxed text-muted-foreground">
                    {post.data.summary}
                  </span>
                )}
              </button>
            ))
          }
        </div>
      </aside>
      <section
        id="note-detail"
        class="relative min-h-0 overflow-y-auto rounded-3xl border border-dashed border-border bg-card/70 p-5 md:p-8"
      >
        <div
          class="note-empty-state absolute inset-0 flex items-center justify-center text-sm font-bold tracking-[0.2em] text-foreground/70 uppercase"
        >
          Select a note
        </div>
        <div class="article-content prose hidden max-w-none dark:prose-invert">
          {
            renderedPosts.map(({ post, rendered }) => {
              const NoteContent = rendered.Content;
              return (
                <article
                  class="note-document hidden"
                  data-note-document={post.id}
                >
                  <>
                    <p class="not-prose mb-3 text-xs font-bold tracking-[0.25em] text-primary uppercase">
                      {post.data.createdAt.toLocaleDateString("en-US", {
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                      })}
                    </p>
                    <h2 class="not-prose mb-6 text-3xl font-black text-foreground md:text-5xl">
                      {post.data.title}
                    </h2>
                    <NoteContent />
                  </>
                </article>
              );
            })
          }
        </div>
      </section>
    </div>
  </div>
</Layout>

<script>
  const initializeNotes = () => {
    const selectors = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".note-select"),
    );
    const documents = Array.from(
      document.querySelectorAll<HTMLElement>(".note-document"),
    );
    if (selectors.length === 0) return;
    selectors.forEach((selector) =>
      selector.addEventListener("click", () => {
        const id = selector.dataset.noteId || "";
        const detail = document.querySelector<HTMLElement>("#note-detail");
        const emptyState =
          detail?.querySelector<HTMLElement>(".note-empty-state");
        const content = detail?.querySelector<HTMLElement>(".article-content");
        selectors.forEach((candidate) => {
          const selected = candidate.dataset.noteId === id;
          candidate.classList.toggle("is-selected", selected);
          candidate.classList.toggle("border-primary/70", selected);
          candidate.classList.toggle("bg-primary/10", selected);
          candidate.classList.toggle("border-border", !selected);
          candidate.classList.toggle("bg-card/65", !selected);
          candidate.setAttribute("aria-pressed", String(selected));
        });
        documents.forEach((document) =>
          document.classList.toggle(
            "hidden",
            document.dataset.noteDocument !== id,
          ),
        );
        emptyState?.classList.add("hidden");
        content?.classList.remove("hidden");
        detail?.classList.remove("border-dashed");
        detail?.classList.add("border-solid");
      }),
    );
  };
  document.addEventListener("astro:page-load", initializeNotes);
</script>
