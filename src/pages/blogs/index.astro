---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Moved: Posts" description="Posts moved to /posts">
  <div class="mx-auto max-w-2xl p-8 md:p-16">
    <h1 class="mb-4 text-3xl font-bold tracking-tight">Posts Moved</h1>
    <p class="mb-6 text-sm text-muted-foreground">
      This section now lives at <a
        href="/posts"
        class="text-primary hover:underline">/posts</a
      >.
    </p>
    <a
      href="/posts"
      class="inline-flex rounded-xl border border-primary/30 px-4 py-2 text-sm text-primary hover:bg-primary/10"
    >
      Go to Posts
    </a>
  </div>
</Layout>
